{
  "name": "obs-master-controller",
  "productName": "EMEET–OBS Bridge",
  "version": "1.1.0",
  "description": "Studio Mode transitions + EMEET PTZ camera presets for OBS Studio",
  "main": "./out/main/index.js",
  "author": "Gi",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "fake-obs": "node scripts/fake-obs.mjs",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "release:win": "electron-vite build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "obs-websocket-js": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
